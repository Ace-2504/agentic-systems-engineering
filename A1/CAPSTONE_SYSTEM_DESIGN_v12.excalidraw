    {
      "id": "al_note_t",
      "type": "text",
      "x": 1454.0,
      "y": 6625.0,
      "width": 532,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f3",
      "index": "b7w",
      "roundness": null,
      "seed": 1936099449,
      "version": 1,
      "versionNonce": 1588939959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "Why it works this way\n- The agent does the typing; a person stays\n  accountable for every entry\n- Priya can push the draft as it is, or correct it\n  first\n- Every correction is reported, so Vikram and\n  Daniel see how often the agent is wrong; this\n  becomes the evaluation data for Lecture 7\n- Nothing waits silently: after 24 hours, or at the\n  cut-off, the open entry is escalated",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "al_note",
      "originalText": "Why it works this way\n- The agent does the typing; a person stays\n  accountable for every entry\n- Priya can push the draft as it is, or correct it\n  first\n- Every correction is reported, so Vikram and\n  Daniel see how often the agent is wrong; this\n  becomes the evaluation data for Lecture 7\n- Nothing waits silently: after 24 hours, or at the\n  cut-off, the open entry is escalated",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
