    {
      "id": "ptr_t",
      "type": "text",
      "x": 4534.0,
      "y": 6985.0,
      "width": 1222,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f5",
      "index": "bAA",
      "roundness": null,
      "seed": 1070113092,
      "version": 1,
      "versionNonce": 1900197732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "Where the tables live now (in CAPSTONE_design.md, so this board stays a picture; CAPSTONE.md is the half-page summary)\n- The money for invoice 4471: \"The story\"\n- The approval rule: \"The approval rule\"\n- What stays human: section 1\n- The sandbox, the kit's traps and my changes: section 2\n- The five jobs: section 3\n- The two never-events and the test scenarios: section 4\n- The bank check in words: section 5\n- The tax steps: the GST credit check and the contract's GST term (6a), the reverse-charge table and workflow (6b),\n  TDS after the deduction (6c), the accounting entries (6d): section 6\n- Guardrails, the five design decisions and the red-team tests: section 7\n- What changes without new code: section 8",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "ptr",
      "originalText": "Where the tables live now (in CAPSTONE_design.md, so this board stays a picture; CAPSTONE.md is the half-page summary)\n- The money for invoice 4471: \"The story\"\n- The approval rule: \"The approval rule\"\n- What stays human: section 1\n- The sandbox, the kit's traps and my changes: section 2\n- The five jobs: section 3\n- The two never-events and the test scenarios: section 4\n- The bank check in words: section 5\n- The tax steps: the GST credit check and the contract's GST term (6a), the reverse-charge table and workflow (6b),\n  TDS after the deduction (6c), the accounting entries (6d): section 6\n- Guardrails, the five design decisions and the red-team tests: section 7\n- What changes without new code: section 8",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
