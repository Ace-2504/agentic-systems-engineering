      "link": null,
      "locked": false,
      "text": "Today: about 15 hand-steps by 5 people over 4 screens and a spreadsheet. The\n0.5% is lost; the team chases the 0.25%, which at Treasury's 6.5% costs\nRs.45,805 more than it saves; blocked GST is claimed and the freight's\nreverse charge missed until the audit",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bsum",
      "originalText": "Today: about 15 hand-steps by 5 people over 4 screens and a spreadsheet. The 0.5% is lost; the team chases the 0.25%, which at Treasury's 6.5% costs Rs.45,805 more than it saves; blocked GST is claimed and the freight's reverse charge missed until the audit",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
