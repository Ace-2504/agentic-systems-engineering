    {
      "id": "dc_n_t",
      "type": "text",
      "x": 4534.0,
      "y": 8140.0,
      "width": 1222,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f5",
      "index": "bAm",
      "roundness": null,
      "seed": 1928799817,
      "version": 1,
      "versionNonce": 1529082965,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "Break-even: discount ÷ (cash paid early × days early ÷ 365). For the 0.5%: Rs.1,19,952 ÷ (Rs.2,81,55,103.32 × 35 ÷\n  365) = 4.44% a year. Below Treasury's rate, keep the money; above it, take the discount. The agent recommends;\n  Vikram decides.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "dc_n",
      "originalText": "Break-even: discount ÷ (cash paid early × days early ÷ 365). For the 0.5%: Rs.1,19,952 ÷ (Rs.2,81,55,103.32 × 35 ÷\n  365) = 4.44% a year. Below Treasury's rate, keep the money; above it, take the discount. The agent recommends;\n  Vikram decides.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
