      "roundness": null,
      "seed": 133676181,
      "version": 1,
      "versionNonce": 409330879,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "What stays human\n- Room inspection and the damage charge (Mr. Joseph,\n  Dr. Menon)\n- Accepting or disputing the charge (Aarav)\n- Approving any bank-detail change (Mr. Batra)\n- Off-cycle runs (Ms. Rao) and authorising payments\n  (Mr. Batra)\n- Giving the agent read access to approved leave dates\n  (HR head and Ms. Rao)\n- Lines the agent cannot match (Ms. Iyer)\n- Not fixed: no move-in record (Failure 10). The agent\n  can only start one for future students",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "hum",
      "originalText": "What stays human\n- Room inspection and the damage charge (Mr. Joseph,\n  Dr. Menon)\n- Accepting or disputing the charge (Aarav)\n- Approving any bank-detail change (Mr. Batra)\n- Off-cycle runs (Ms. Rao) and authorising payments\n  (Mr. Batra)\n- Giving the agent read access to approved leave dates\n  (HR head and Ms. Rao)\n- Lines the agent cannot match (Ms. Iyer)\n- Not fixed: no move-in record (Failure 10). The agent\n  can only start one for future students",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
