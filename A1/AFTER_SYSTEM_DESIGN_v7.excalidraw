      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "b1",
      "originalText": "[Agent] 2nd May: verify_bank_account sends Rs.1 to Aarav's current account: OK. Finds the ERP student record still holds his closed 2022 account, so it raises a bank-detail change in the ERP with the proof attached",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
