      "updated": 1793760000000,
      "created": 1793760000000,
      "link": null,
      "locked": false,
      "text": "The rest of the old right-hand panels now live in AFTER_integration.md:\n- the order of ways in (API, events, files, read-only SQL views, screen driver; never SQL writes),\n  each system's best way in, and how the agent itself is controlled: section 1\n- the configuration fixes marked (*): section 2",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The rest of the old right-hand panels now live in AFTER_integration.md:\n- the order of ways in (API, events, files, read-only SQL views, screen driver; never SQL writes),\n  each system's best way in, and how the agent itself is controlled: section 1\n- the configuration fixes marked (*): section 2",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
