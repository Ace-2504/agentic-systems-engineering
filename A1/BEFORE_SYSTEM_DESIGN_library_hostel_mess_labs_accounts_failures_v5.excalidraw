      "link": null,
      "locked": false,
      "roundness": null,
      "text": "12th May: ERP creates refund\nRV-25-1184 for Rs.14,460. Bank\naccount taken from the student\nmaster record (2022 account,\nclosed in 2024), not from the\nform. EduDesk shows Forwarded\nto Accounts, no date",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "acc1",
      "originalText": "12th May: ERP creates refund RV-25-1184 for Rs.14,460. Bank account taken from the student master record (2022 account, closed in 2024), not from the form. EduDesk shows Forwarded to Accounts, no date",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
