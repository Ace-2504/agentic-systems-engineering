      "updated": 1793718452081,
      "created": 1793708727162,
      "link": null,
      "locked": false,
      "text": "2nd May: Aarav logs into EduDesk\nand fills the No-Dues & Deposit\nRefund form, entering his current\nbank account (verified on the\nspot by a Rs.1 test transfer).\nRequest REQ-25-0917 is created;\nacknowledgement email sent",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0loLu47ZKeMAqDo5gHUcS",
      "originalText": "2nd May: Aarav logs into EduDesk and fills the No-Dues & Deposit Refund form, entering his current bank account (verified on the spot by a Rs.1 test transfer). Request REQ-25-0917 is created; acknowledgement email sent",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
