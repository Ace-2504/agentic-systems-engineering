    {
      "id": "bc_note_t",
      "type": "text",
      "x": 3524.0,
      "y": 7532.5,
      "width": 732,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f4",
      "index": "bA3",
      "roundness": null,
      "seed": 1020708045,
      "version": 1,
      "versionNonce": 1130172783,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "Why it works this way\n- Emails can be faked; the bank's statement and return file cannot be\n  sent by an outsider, so only they decide paid or returned\n- The reader that touches email text has no tools, so instructions\n  hidden in an email have nowhere to go\n- The agent never changes anything because an email asks it to\n- Every bank debit is matched to an approved payment, so a payment\n  made around the gateway, or from an edited file, is caught the next\n  morning\n- NBAS says paid only after this check, not when the file is uploaded",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "bc_note",
      "originalText": "Why it works this way\n- Emails can be faked; the bank's statement and return file cannot be\n  sent by an outsider, so only they decide paid or returned\n- The reader that touches email text has no tools, so instructions\n  hidden in an email have nowhere to go\n- The agent never changes anything because an email asks it to\n- Every bank debit is matched to an approved payment, so a payment\n  made around the gateway, or from an edited file, is caught the next\n  morning\n- NBAS says paid only after this check, not when the file is uploaded",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
