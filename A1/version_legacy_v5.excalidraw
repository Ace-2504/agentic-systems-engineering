    },
    {
      "id": "al_note_t",
      "type": "text",
      "x": 1454.0,
      "y": 7532.5,
      "width": 612,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f3",
      "index": "b9F",
      "roundness": null,
      "seed": 957473606,
      "version": 1,
      "versionNonce": 927362216,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "Why it works this way\n- NBAS has one shared login and keeps no approvals, so the\n  gateway is where \"who approved what\" lives. Everyone\n  signs in to it with their own company login\n- The rules Ledgerline enforced on its own (holds, release\n  lists, the calendar, early payments) are enforced by the\n  gateway, not left to the manual: the logic in code, the\n  numbers and names in approved tables\n- The agent does the typing; a person stays accountable for\n  every entry, and every correction is reported (evaluation\n  data for Lecture 7)\n- Only the gateway writes into NBAS. Before writing, it\n  checks NBAS through the adapter that the entry is not\n  already there, so a retry never makes a copy\n- Nothing waits silently: after 24 hours, or at the cut-\n  off, the open entry is escalated",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "al_note",
      "originalText": "Why it works this way\n- NBAS has one shared login and keeps no approvals, so the\n  gateway is where \"who approved what\" lives. Everyone\n  signs in to it with their own company login\n- The rules Ledgerline enforced on its own (holds, release\n  lists, the calendar, early payments) are enforced by the\n  gateway, not left to the manual: the logic in code, the\n  numbers and names in approved tables\n- The agent does the typing; a person stays accountable for\n  every entry, and every correction is reported (evaluation\n  data for Lecture 7)\n- Only the gateway writes into NBAS. Before writing, it\n  checks NBAS through the adapter that the entry is not\n  already there, so a retry never makes a copy\n- Nothing waits silently: after 24 hours, or at the cut-\n  off, the open entry is escalated",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
