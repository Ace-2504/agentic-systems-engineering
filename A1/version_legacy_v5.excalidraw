      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "Today on NBAS: about 15 hand-steps by 5 people, a spreadsheet for holds,\nemails for approvals, and no record of who did what. The 0.5% is lost, and\nNBAS says paid before the bank does",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bsum",
      "originalText": "Today on NBAS: about 15 hand-steps by 5 people, a spreadsheet for holds, emails for approvals, and no record of who did what. The 0.5% is lost, and NBAS says paid before the bank does",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
