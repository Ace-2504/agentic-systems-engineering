    {
      "id": "intro_t",
      "type": "text",
      "x": 14,
      "y": 90,
      "width": 1772,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "f0",
      "index": "a2",
      "roundness": null,
      "seed": 1397871145,
      "version": 1,
      "versionNonce": 103694313,
      "isDeleted": false,
