      "versionNonce": 1763673107,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793750000000,
      "created": 1793750000000,
      "link": null,
      "locked": false,
      "text": "[Human] = a person does it    [Agent] = Ask Northbridge does it    [Gateway] = the approval layer we build    [NBAS] = the old system on its own    Adapter = our API in front of NBAS's XML interface    Diamond = a decision\nThick line = the path invoice 4471 takes.  Thin line = the other answers.  Red = how it goes wrong today.  Green = how the design fixes it.  → approval loop = the entry goes through frame 3.  Arrows show order in time.\nEach band reads left to right, phase by phase; \"continues in phase N\" joins the columns.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[Human] = a person does it    [Agent] = Ask Northbridge does it    [Gateway] = the approval layer we build    [NBAS] = the old system on its own    Adapter = our API in front of NBAS's XML interface    Diamond = a decision\nThick line = the path invoice 4471 takes.  Thin line = the other answers.  Red = how it goes wrong today.  Green = how the design fixes it.  → approval loop = the entry goes through frame 3.  Arrows show order in time.\nEach band reads left to right, phase by phase; \"continues in phase N\" joins the columns.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
